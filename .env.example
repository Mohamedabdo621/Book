# Copy each value into Supabase Edge Function secrets — never commit real values.
#   supabase secrets set TELEGRAM_BOT_TOKEN=... TELEGRAM_BOT_USERNAME=... \
#     TELEGRAM_WEBHOOK_SECRET=... CRON_SECRET=... POLAR_CHECKOUT_URL=... PAYMENTS_ENABLED=false
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
CRON_SECRET=replace-with-another-long-random-string
POLAR_CHECKOUT_URL=
PAYMENTS_ENABLED=false
